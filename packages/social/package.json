{
  "name": "@avizor/social",
  "version": "0.3.3",
  "private": true,
  "description": "Capa social de Avizor: cuentas, sesiones web, capacidades reales, compositor y cola de acciones. TypeScript puro, sin claves API.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
