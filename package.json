{
  "name": "avizor",
  "version": "0.3.4",
  "private": true,
  "description": "Avizor — el pulso de internet. Local-first, sin cuenta, sin servidor.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "smouj",
    "email": "smouj@users.noreply.github.com",
    "url": "https://github.com/smouj"
  },
  "homepage": "https://github.com/smouj/avizor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smouj/avizor.git"
  },
  "bugs": {
    "url": "https://github.com/smouj/avizor/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @avizor/app dev",
    "dev:desktop": "pnpm --filter @avizor/desktop dev",
    "build": "pnpm --filter @avizor/tokens build && pnpm --filter @avizor/engine build && pnpm --filter @avizor/app build",
    "build:desktop": "pnpm build && pnpm --filter @avizor/desktop build",
    "preview": "pnpm --filter @avizor/app preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @avizor/engine test && pnpm --filter @avizor/social test",
    "test:watch": "pnpm --filter @avizor/engine test:watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bash scripts/verify.sh",
    "clean": "rm -rf packages/*/dist apps/*/dist apps/desktop/src-tauri/target"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tauri-apps/cli"
    ]
  }
}
